# Environment Variables
# Copy this file to .env and fill in your values

# Server port (default: 5000)
PORT=5000

# MongoDB connection string
# Local:  mongodb://localhost:27017/expense-tracker
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/expense-tracker
MONGODB_URI=mongodb://localhost:27017/expense-tracker

# JWT secret key — use a long, random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
